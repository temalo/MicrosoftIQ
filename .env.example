# Copy to app/.env and fill in your values.
# (The web app reads this file via a tiny built-in loader.)

# Branding shown in the web client
BRAND=Contoso Events

# Azure AI Foundry project that hosts the published orchestrator agent
FOUNDRY_ACCOUNT=https://YOUR-FOUNDRY.services.ai.azure.com
FOUNDRY_PROJECT=your-project
FOUNDRY_AGENT=ConferenceIQ-Orchestrator
FOUNDRY_API_VERSION=2025-05-15-preview

# Optional
PORT=3000
# AZURE_TENANT=organizations        # or a tenant GUID / domain
# AZURE_CLIENT_ID=04b07795-8ddb-461a-bbee-02f9e1bf7b46   # Azure CLI public client
