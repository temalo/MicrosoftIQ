// Run each management command separately in your chosen demo KQL database.
// Create only; do not drop/replace existing tables or mappings.
.create table BoothDim (BoothId:long, ConferenceSponsorId:long, ConferenceId:long, SponsorId:long, SponsorName:string, Tier:string, BoothCode:string)
.create table ScanDevice (DeviceId:string, BoothId:long, ConferenceId:long, DeviceType:string)
.create table RunInfo (RunId:string, Seed:long, ModelHash:string, StartedAt:datetime, PlannedEndAt:datetime, ConfigJson:string)
.create table BadgeScan (ScanId:string, RunId:string, Seed:long, ScanTimestamp:datetime, ConferenceId:long, BoothId:long, SponsorId:long, UserId:long, DeviceId:string, ScanType:string, DwellSeconds:long, IsLicensedUser:bool, OptInShareContact:bool, IsQualified:bool, IsSynthetic:bool)

.create table BoothDim ingestion json mapping 'BoothDimMapping' '[{"column":"BoothId","Properties":{"Path":"$.BoothId"}},{"column":"ConferenceSponsorId","Properties":{"Path":"$.ConferenceSponsorId"}},{"column":"ConferenceId","Properties":{"Path":"$.ConferenceId"}},{"column":"SponsorId","Properties":{"Path":"$.SponsorId"}},{"column":"SponsorName","Properties":{"Path":"$.SponsorName"}},{"column":"Tier","Properties":{"Path":"$.Tier"}},{"column":"BoothCode","Properties":{"Path":"$.BoothCode"}}]'
.create table ScanDevice ingestion json mapping 'ScanDeviceMapping' '[{"column":"DeviceId","Properties":{"Path":"$.DeviceId"}},{"column":"BoothId","Properties":{"Path":"$.BoothId"}},{"column":"ConferenceId","Properties":{"Path":"$.ConferenceId"}},{"column":"DeviceType","Properties":{"Path":"$.DeviceType"}}]'
.create table RunInfo ingestion json mapping 'RunInfoMapping' '[{"column":"RunId","Properties":{"Path":"$.RunId"}},{"column":"Seed","Properties":{"Path":"$.Seed"}},{"column":"ModelHash","Properties":{"Path":"$.ModelHash"}},{"column":"StartedAt","Properties":{"Path":"$.StartedAt"}},{"column":"PlannedEndAt","Properties":{"Path":"$.PlannedEndAt"}},{"column":"ConfigJson","Properties":{"Path":"$.ConfigJson"}}]'
.create table BadgeScan ingestion json mapping 'BadgeScanMapping' '[{"column":"ScanId","Properties":{"Path":"$.ScanId"}},{"column":"RunId","Properties":{"Path":"$.RunId"}},{"column":"Seed","Properties":{"Path":"$.Seed"}},{"column":"ScanTimestamp","Properties":{"Path":"$.ScanTimestamp"}},{"column":"ConferenceId","Properties":{"Path":"$.ConferenceId"}},{"column":"BoothId","Properties":{"Path":"$.BoothId"}},{"column":"SponsorId","Properties":{"Path":"$.SponsorId"}},{"column":"UserId","Properties":{"Path":"$.UserId"}},{"column":"DeviceId","Properties":{"Path":"$.DeviceId"}},{"column":"ScanType","Properties":{"Path":"$.ScanType"}},{"column":"DwellSeconds","Properties":{"Path":"$.DwellSeconds"}},{"column":"IsLicensedUser","Properties":{"Path":"$.IsLicensedUser"}},{"column":"OptInShareContact","Properties":{"Path":"$.OptInShareContact"}},{"column":"IsQualified","Properties":{"Path":"$.IsQualified"}},{"column":"IsSynthetic","Properties":{"Path":"$.IsSynthetic"}}]'

// Required for the independent direct-streaming path. Confirm workspace support.
.alter table BadgeScan policy streamingingestion enable
.alter table RunInfo policy streamingingestion enable
